---
import ThemeToggle from "../ThemeToggle.astro";
import { MENU_LINKS } from "@/data/constants";

const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (path: string) => {
	const base = path.replace(/\/+$/, "") || "/";
	return base === "/" ? pathname === "/" : pathname === base || pathname.startsWith(`${base}/`);
};
---

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const header = document.getElementById("main-header");
		const button = document.getElementById("toggle-navigation-menu");
		if (!header || !button) return;

		const setOpen = (open: boolean) => {
			header.classList.toggle("menu-open", open);
			button.setAttribute("aria-expanded", String(open));
			button.setAttribute("aria-label", open ? "Close main menu" : "Open main menu");
		};

		button.addEventListener("click", () => setOpen(!header.classList.contains("menu-open")));

		// close with Escape (and give focus back to the button) or by clicking outside the header
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && header.classList.contains("menu-open")) {
				setOpen(false);
				button.focus();
			}
		});
		document.addEventListener("click", (e) => {
			if (!header.contains(e.target as Node)) setOpen(false);
		});
	});
</script>

<header id="main-header" class="group relative mb-28 flex items-center">
	<div class="flex sm:flex-col">
		<a
			href="/"
			class="inline-flex items-center grayscale hover:filter-none sm:relative sm:inline-block"
			aria-current={pathname === "/" ? "page" : false}
		>
			<span class="text-xl font-bold sm:text-2xl">clipboard</span>
		</a>
		<nav
			id="navigation-menu"
			class="absolute -inset-x-4 top-14 hidden flex-col items-end gap-y-4 rounded-md bg-[color:var(--theme-menu-bg)] py-4 text-accent shadow backdrop-blur group-[.menu-open]:z-50 group-[.menu-open]:flex sm:static sm:z-auto sm:-ml-4 sm:mt-1 sm:flex sm:flex-row sm:items-center sm:divide-x sm:divide-dashed sm:divide-accent sm:rounded-none sm:bg-transparent sm:py-0 sm:shadow-none sm:backdrop-blur-none"
			aria-label="Main menu"
		>
			{
				MENU_LINKS.map((link) => (
					<a
						href={link.path}
						class="px-4 py-4 sm:py-0 sm:hover:underline"
						aria-current={isActive(link.path) ? "page" : false}
						data-astro-prefetch
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	<ThemeToggle />
	<button
		id="toggle-navigation-menu"
		class="group relative ml-8 h-7 w-7 sm:invisible sm:hidden"
		type="button"
		aria-label="Open main menu"
		aria-expanded="false"
		aria-controls="navigation-menu"
	>
		<svg
			id="line-svg"
			class="absolute left-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
			aria-hidden="true"
			focusable="false"
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.5"
			stroke="currentColor"
		>
			<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
		</svg>
		<svg
			id="cross-svg"
			class="absolute left-1/2 top-1/2 h-full w-full -translate-x-1/2 -translate-y-1/2 scale-0 text-accent opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
			aria-hidden="true"
			focusable="false"
			xmlns="http://www.w3.org/2000/svg"
			fill="none"
			viewBox="0 0 24 24"
			stroke-width="1.5"
			stroke="currentColor"
		>
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
		</svg>
	</button>
</header>
