---
---

<div class="search-container">
	<label for="search-input" class="sr-only">Search posts</label>
	<input
		type="search"
		id="search-input"
		placeholder="Search posts..."
		autocomplete="off"
		class="w-full rounded-md border px-3 py-2 dark:border-gray-700 dark:bg-gray-800"
	/>
	<p id="search-status" class="sr-only" aria-live="polite"></p>
	<p id="search-message" class="mt-2 text-gray-600 dark:text-gray-400"></p>
	<ul id="search-results" class="mt-2 space-y-2"></ul>
</div>

<script>
	import Fuse from "fuse.js";

	type Entry = { slug: string; title: string; description: string; tags: string[] };

	const input = document.getElementById("search-input") as HTMLInputElement | null;
	const results = document.getElementById("search-results");
	const status = document.getElementById("search-status");
	const message = document.getElementById("search-message");

	if (input && results && status && message) {
		let fuse: Fuse<Entry> | undefined;
		let loading: Promise<void> | undefined;

		// the index is only downloaded the first time the box is used
		const load = () => {
			loading ??= fetch("/search.json")
				.then((res) => {
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					return res.json() as Promise<Entry[]>;
				})
				.then((entries) => {
					fuse = new Fuse(entries, {
						keys: [
							{ name: "title", weight: 3 },
							{ name: "tags", weight: 2 },
							{ name: "description", weight: 1 },
						],
						threshold: 0.35,
						ignoreLocation: true,
					});
				})
				.catch((error) => {
					// allow a retry on the next keystroke instead of caching the failure
					loading = undefined;
					throw error;
				});
			return loading;
		};

		const render = (entries: Entry[]) => {
			results.replaceChildren(
				...entries.map((entry) => {
					const li = document.createElement("li");
					const a = document.createElement("a");
					a.href = `/posts/${entry.slug}/`;
					a.className = "block rounded-lg p-4 hover:bg-gray-100 dark:hover:bg-gray-700";
					const h3 = document.createElement("h3");
					h3.className = "text-lg font-semibold";
					h3.textContent = entry.title;
					a.append(h3);
					if (entry.description) {
						const p = document.createElement("p");
						p.className = "text-gray-600 dark:text-gray-400";
						p.textContent = entry.description;
						a.append(p);
					}
					li.append(a);
					return li;
				})
			);
		};

		const search = async () => {
			const query = input.value.trim();
			if (!query) {
				render([]);
				message.textContent = "";
				status.textContent = "";
				return;
			}
			try {
				await load();
			} catch {
				render([]);
				message.textContent = "Search is unavailable right now. Please try again.";
				status.textContent = message.textContent;
				return;
			}
			const found = fuse!.search(query, { limit: 10 }).map((r) => r.item);
			render(found);
			const text = found.length
				? `${found.length} result${found.length === 1 ? "" : "s"} found`
				: `No posts found for "${query}".`;
			message.textContent = found.length ? "" : text;
			status.textContent = text;
		};

		let timeout: ReturnType<typeof setTimeout>;
		input.addEventListener("focus", () => void load());
		input.addEventListener("input", () => {
			clearTimeout(timeout);
			timeout = setTimeout(() => void search(), 200);
		});
	}
</script>
