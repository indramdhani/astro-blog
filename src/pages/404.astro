---
import PageLayout from "@/layouts/Base";

const meta = {
	title: "Page not found",
	description: "The page you are looking for does not exist or has been moved.",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6">404 | Page not found</h1>
	<p class="mb-4">The page you are looking for does not exist or has been moved.</p>
	<p class="mb-8">
		Try the <a class="cactus-link" href="/posts">list of posts</a>, or go back
		<a class="cactus-link" href="/">home</a>.
	</p>
</PageLayout>
