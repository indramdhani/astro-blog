---
import PageLayout from "@/layouts/Base";
import { getAllPosts } from "@/utils/collection";
import { getSeries, tagSlug } from "@/utils";

const series = getSeries(await getAllPosts());

const meta = {
	title: "Collections",
	description: "Series of posts that belong together, such as Docker, server, AWS and code notes.",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title">collections</h1>
		<ul class="list-inside list-disc">
			{
				series.map(([tag, count]) => (
					<li>
						<a class="cactus-link" href={`/tags/${tagSlug(tag)}/`}>
							{tag}
						</a>
						<span class="text-gray-500">
							- {count} post{count > 1 ? "s" : ""}
						</span>
					</li>
				))
			}
		</ul>
	</div>
</PageLayout>
