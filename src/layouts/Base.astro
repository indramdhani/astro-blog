---
import type { SiteMeta } from "@/data/siteMeta";
import BaseHead from "@/components/BaseHead";
import Header from "@/components/layout/Header";
import Footer from "@/components/layout/Footer";
import SkipLink from "@/components/SkipLink";
import siteConfig, { languages } from "@/site-config";

interface Props {
	meta: SiteMeta;
}

const {
	meta: {
		title,
		description = siteConfig.description,
		ogImage,
		ogImageAlt,
		articleDate,
		updatedDate,
		tags,
		lang = "en",
		noindex = false,
	},
} = Astro.props;
---

<html lang={languages[lang].htmlLang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			ogImage={ogImage}
			ogImageAlt={ogImageAlt}
			articleDate={articleDate}
			updatedDate={updatedDate}
			tags={tags}
			lang={lang}
			noindex={noindex}
		/>
		<script define:vars={{ siteConfig }}>
			const root = document.documentElement;
			const colorThemeMetaTags = document.querySelectorAll("meta[name='theme-color']");

			// get user preference of dark mode, 1st local storage, 2nd browser
			function getThemePreference() {
				if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
					return localStorage.getItem("theme");
				}
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			const isDark = getThemePreference() === "dark";

			// watch the document element class and keep the theme-color meta tags in sync.
			const observer = new MutationObserver(() => {
				const rootIsDark = root.classList.contains("dark");
				// the manual toggle wins over the OS preference, so drop the media queries
				colorThemeMetaTags.forEach((tag) => {
					tag.removeAttribute("media");
					tag.setAttribute(
						"content",
						siteConfig[rootIsDark ? "themeColorDark" : "themeColorLight"]
					);
				});
			});
			observer.observe(root, { attributeFilter: ["class"] });

			// initialise root class attribute
			root.classList.toggle("dark", isDark);

			// until the visitor picks a theme with the toggle, follow the OS setting live
			window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
				if (typeof localStorage === "undefined" || !localStorage.getItem("theme")) {
					root.classList.toggle("dark", e.matches);
				}
			});
		</script>
	</head>
	<body>
		<SkipLink />
		<Header />
		<main id="main" class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>
